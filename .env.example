# ── Gemini (hybrid AI pass on POST /api/convert) ───────────────────────────
# Choose ONE of the two auth paths below.

# Path 1 — AI Studio API key (simple / dev).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Path 2 — Vertex AI (enterprise; uses the runtime service account / Workload
# Identity, no raw key). Set USE_VERTEXAI=true and provide project + location.
GOOGLE_GENAI_USE_VERTEXAI="false"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"

# Model used for the hybrid enhancement pass.
GEMINI_MODEL="gemini-2.5-flash"

# ── App ────────────────────────────────────────────────────────────────────
# Port the Express backend listens on (Cloud Run injects PORT automatically).
PORT="8080"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Set to 'true' to disable Vite HMR.
DISABLE_HMR="false"
